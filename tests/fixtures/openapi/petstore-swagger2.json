{
  "swagger": "2.0",
  "info": { "title": "Petstore (Swagger 2.0, e.g. springfox or older .NET)", "version": "1.0" },
  "basePath": "/v1",
  "produces": ["application/json"],
  "paths": {
    "/pets": {
      "get": {
        "tags": ["pet-controller"],
        "operationId": "listPetsUsingGET",
        "parameters": [{ "name": "limit", "in": "query", "type": "integer", "required": false }],
        "responses": { "200": { "description": "OK", "schema": { "type": "array", "items": { "$ref": "#/definitions/Pet" } } } }
      },
      "post": {
        "tags": ["pet-controller"],
        "operationId": "addPetUsingPOST",
        "parameters": [{ "name": "pet", "in": "body", "required": true, "schema": { "$ref": "#/definitions/Pet" } }],
        "responses": { "201": { "description": "Created", "schema": { "$ref": "#/definitions/Pet" } } }
      }
    },
    "/pets/{petId}": {
      "delete": {
        "tags": ["pet-controller"],
        "operationId": "deletePetUsingDELETE",
        "parameters": [{ "name": "petId", "in": "path", "type": "integer", "required": true }],
        "responses": { "204": { "description": "No Content" } }
      }
    }
  },
  "definitions": {
    "Pet": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "pending", "sold"] }
      }
    }
  }
}
